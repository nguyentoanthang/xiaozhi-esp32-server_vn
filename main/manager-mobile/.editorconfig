root = true

[*] # applies to all files
charset = utf-8 # set the file charset to utf-8
indent_style = space # indent style (tab | space)
indent_size = 2 # indent size
end_of_line = lf # line ending type (lf | cr | crlf)
trim_trailing_whitespace = true # trim trailing whitespace
insert_final_newline = true # always insert a final newline

[*.md] # the following rules apply to md files only
max_line_length = off # disable the max line length limit
trim_trailing_whitespace = false # disable trailing whitespace trimming
