# TIPS: if some files are already under version control, adding them to .gitignore now has no effect; run the following
# `git rm -r --cached .` and then commit.

# git rm -r --cached file1 file2  ## for some files
# git rm -r --cached dir1 dir2  ## for some directories
# git rm -r --cached .  ## for all files

